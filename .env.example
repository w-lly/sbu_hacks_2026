# Optional: Google Gemini powers the AI director (upcoming upgrades/orders) and the final report.
# Get a key at https://aistudio.google.com/apikey
# When omitted (or when a Gemini call fails), the game uses built-in RNG upgrades/orders and rule-based reports.
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=
# Optional: ElevenLabs narration of tutorials, orders and popups (toggle in Settings).
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
