# Optional: use Google Gemini for the Chief Engineer report instead of the built-in Lovable AI.
# Get a key at https://aistudio.google.com/apikey
# When omitted (or when a Gemini call fails), the app automatically falls back to Lovable AI.
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=
